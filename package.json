    "protobufjs@7.6.2": true,
    "ssh2@1.17.0": true,
    "@prisma/engines@5.22.0": true,
    "argon2@0.41.1": true,
    "cpu-features@0.0.10": true,
    "@nestjs/core@10.4.22": true,
    "@prisma/client@5.22.0": true
