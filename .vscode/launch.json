{
  // OrbixHub — configs de execução/depuração.
  // "node-terminal" usa o depurador JS embutido do VSCode (sem extensão extra).
  // A config Flutter exige a extensão Dart/Flutter + Flutter SDK instalado.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Back: dev (watch)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run start:dev --workspace back",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Back: build",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run build --workspace back",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Back: e2e tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run test:e2e --workspace back",
      "cwd": "${workspaceFolder}"
    },
    {
      // Popula a oficina-demo (clientes, veículos, estoque, OS, chat). Idempotente.
      "name": "Back: seed (dev data)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run back:seed",
      "cwd": "${workspaceFolder}"
    },
    {
      // Web na porta 8090 (já está em CORS_ORIGINS do back e em APP_PUBLIC_URL).
      // Chrome não instalado nesta máquina → web-server: abra a URL em qualquer browser.
      "name": "Front: Flutter web (8090)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/front",
      "deviceId": "web-server",
      "args": ["--web-port=8090", "--dart-define=DEV_TOOLS=true", "--dart-define=API_BASE_URL=http://localhost:3000/api"]
    },
    {
      // Alternativa: rodar no Chrome (instale o Google Chrome para habilitar).
      "name": "Front: Flutter (chrome)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/front",
      "deviceId": "chrome",
      "args": ["--web-port=8090", "--dart-define=DEV_TOOLS=true", "--dart-define=API_BASE_URL=http://localhost:3000/api"]
    },
    {
      // Desktop Windows. Só roda EM uma máquina Windows. (target `windows/` já existe.)
      "name": "Front: Flutter Windows",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/front",
      "deviceId": "windows",
      "args": ["--dart-define=DEV_TOOLS=true"]
    },
    {
      // Desktop macOS. Pré-requisito: gerar o target → `cd front && flutter create --platforms=macos .`
      "name": "Front: Flutter macOS",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/front",
      "deviceId": "macos",
      "args": ["--dart-define=DEV_TOOLS=true", "--dart-define=API_BASE_URL=http://localhost:3000/api"]
    },
    {
      // Android — detecta o device/emulador Android conectado (sem hardcode de id)
      // e roda nele. Se não houver nenhum, o script avisa como abrir um emulador.
      // API_BASE_URL=10.0.2.2 porque no emulador Android o host/backend NÃO é localhost.
      // (node-terminal: hot reload pelo terminal com 'r'. Para breakpoints, use o
      //  seletor de device da barra de status + uma config "dart".)
      "name": "Front: Flutter Android",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash scripts/run-flutter.sh android --dart-define=DEV_TOOLS=true --dart-define=API_BASE_URL=http://10.0.2.2:3000/api",
      "cwd": "${workspaceFolder}/front"
    },
    {
      // iOS (somente em macOS) — detecta o simulador/device iOS e roda nele.
      // Pré-requisitos: `flutter create --platforms=ios .` + Xcode + CocoaPods +
      // um simulador iOS aberto. (No simulador iOS o backend é localhost mesmo.)
      "name": "Front: Flutter iOS",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash scripts/run-flutter.sh ios --dart-define=DEV_TOOLS=true",
      "cwd": "${workspaceFolder}/front"
    },
    {
      // Gera o instalador Windows de produção (build release + Inno Setup).
      // Só roda numa máquina Windows. Pré-requisitos em scripts/build_installer.ps1.
      "name": "Front: Build Windows installer (prod)",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -ExecutionPolicy Bypass -File scripts\\build_installer.ps1",
      "cwd": "${workspaceFolder}/front"
    },
    {
      // Gera o APK de produção (env/prod.json) para instalação direta no Android.
      "name": "Front: Build Android APK (prod)",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash scripts/build_prod.sh apk",
      "cwd": "${workspaceFolder}/front"
    }
  ]
}
