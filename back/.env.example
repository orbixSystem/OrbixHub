NODE_ENV=development
PORT=3000
# --- Postgres port note -------------------------------------------------------
# LOCAL (this machine, Podman): host port is 55432 (native PG owns 5432).
# CI / docker-compose:          host port is 5432.
# Keep your gitignored .env on 55432 locally; CI sets 5432 via service containers.
# -----------------------------------------------------------------------------
# App connects as the NON-privileged app_user (RLS enforced)
DATABASE_URL=postgresql://app_user:app_user_pw@localhost:55432/orbixhub?schema=public
# Migrations run as app_migrator (BYPASSRLS)
MIGRATION_DATABASE_URL=postgresql://app_migrator:app_migrator_pw@localhost:55432/orbixhub?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change_me_to_a_random_32_byte_minimum_secret_string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
ARGON_MEMORY_KIB=19456
ARGON_TIME_COST=2
ARGON_PARALLELISM=1
# --- Billing -----------------------------------------------------------------
# Plan key granted on trial signup (seeded plans: trial, pro)
TRIAL_PLAN_KEY=trial
TRIAL_DAYS=14
# false = validation phase: subscribe activates immediately, no gateway call.
# true  = checkout via PaymentGateway; status becomes authoritative via webhook.
BILLING_REQUIRE_PAYMENT=false
# HMAC-SHA256 secret the gateway signs webhook bodies with (min 16 chars).
BILLING_WEBHOOK_SECRET=dev_billing_webhook_secret_change_me
# --- Dev tools ---------------------------------------------------------------
# Dev tools — NEVER enable in production (exposes invite links / reset tokens via /dev/inbox)
DEV_TOOLS_ENABLED=false
# Public base URL of the app (used to build invite deep links in the dev inbox)
APP_PUBLIC_URL=http://localhost:8090
# --- Inventory catalog lookup (código-first) ---------------------------------
# External GTIN/EAN catalog provider: noop (always empty) | cosmos
CATALOG_PROVIDER=noop
# Master kill-switch. false = never call the external catalog (validation phase).
CATALOG_ENABLED=false
# Bearer token for cosmos.bluesoft.com.br — SECRET, never commit a real value.
COSMOS_TOKEN=
