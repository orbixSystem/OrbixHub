NODE_ENV=development
PORT=3000
# Local dev (Podman): host port 55432 (native PG owns 5432).
# App connects as the NON-privileged app_user (RLS enforced).
DATABASE_URL=postgresql://app_user:app_user_pw@localhost:55432/orbixhub?schema=public
# Migrations run as app_migrator (BYPASSRLS).
MIGRATION_DATABASE_URL=postgresql://app_migrator:app_migrator_pw@localhost:55432/orbixhub?schema=public
# Baseline/DDL applied AS app_owner (table owner / superuser) via scripts/ci-db-setup.ts.
ADMIN_DATABASE_URL=postgresql://app_owner:owner_pw@localhost:55432/orbixhub?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change_me_to_a_random_32_byte_minimum_secret_string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8090
ARGON_MEMORY_KIB=19456
ARGON_TIME_COST=2
ARGON_PARALLELISM=1
# --- Billing ---
TRIAL_PLAN_KEY=trial
TRIAL_DAYS=14
BILLING_REQUIRE_PAYMENT=false
# Régua de acesso pelo STATUS da assinatura (past_due bloqueia escrita, canceled
# bloqueia tudo) + job diário que expira trials. DESLIGADA por padrão até existir
# o módulo de assinatura — ligada, um trial vencido põe o tenant inteiro em
# somente-leitura sem nenhum caminho para regularizar.
BILLING_ENFORCE_SUBSCRIPTION=false
BILLING_WEBHOOK_SECRET=dev_billing_webhook_secret_change_me
DEV_TOOLS_ENABLED=true
APP_PUBLIC_URL=http://localhost:8090
# --- Nota Fiscal (invoice module) ---
# Fiscal provider:
#   noop        = synthetic authorization in dev (no external call)
#   govbr       = National NFS-e API (gov.br), free
#   nuvemfiscal = Nuvem Fiscal BaaS provider
FISCAL_PROVIDER=noop
# Default fiscal environment for new invoices
FISCAL_ENVIRONMENT=homologacao
# HMAC-SHA256 secret the fiscal webhook signs bodies with (min 16 chars) — SECRET, never commit real values
INVOICE_WEBHOOK_SECRET=dev_invoice_webhook_secret_change_me
# Nuvem Fiscal provider credentials (global platform credentials)
NUVEMFISCAL_CLIENT_ID=
NUVEMFISCAL_CLIENT_SECRET=
NUVEMFISCAL_BASE_URL=https://api.nuvemfiscal.com.br
NUVEMFISCAL_AUTH_URL=https://auth.nuvemfiscal.com.br/oauth/token
# --- Inventory catalog lookup (código-first) ---
CATALOG_PROVIDER=cosmos
CATALOG_ENABLED=true
COSMOS_TOKEN=a
# --- Storage (fotos da OS) ---
# Provider local serve em GET /api/files/* (prefixo global /api). A URL pública
# precisa apontar pro backend real (4500) COM o /api, senão a foto 404 → placeholder.
STORAGE_PROVIDER=local
STORAGE_PUBLIC_URL=http://localhost:4500/api
# --- Consulta de placas (apiplacas.com.br / wdapi2) ---
PLACAS_ENABLED=false
PLACAS_TOKEN=
PLACAS_BASE_URL=https://wdapi2.com.br
PLACAS_MONTHLY_LIMIT=1000

# --- Atualização do app instalado (Android/Windows) ---
# O backend lê a última release do GitHub e diz ao app o que baixar.
APP_UPDATE_ENABLED=false
GITHUB_RELEASES_REPO=orbixSystem/OrbixHub
# Opcional: o repositório é público, então o token só serve para elevar o
# limite da API do GitHub (60 req/h anônimo → 5.000 req/h). Secret.
GITHUB_RELEASES_TOKEN=

# --- E-mail (verificação de conta, reset de senha, convite de equipe) ---
# 'dev' = dev-inbox/besouro, nada sai da máquina (default seguro).
# 'smtp' = envio real. Em produção é smtp.
MAIL_TRANSPORT=dev
# Google Workspace. Porta 587 usa STARTTLS → SMTP_SECURE=false (465 seria true).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Conta que autentica. Precisa de 2FA ligado + senha de app de 16 letras
# (myaccount.google.com/apppasswords), colada aqui SEM espaços. Secret.
SMTP_USER=
SMTP_PASS=
# Remetente visível: a própria SMTP_USER ou um alias verificado no Gmail em
# Configurações → Contas → Enviar e-mail como. Senão o Google reescreve o From.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=OrbixHub
# NB: os links dentro dos e-mails saem de APP_PUBLIC_URL (lá em cima). Em
# produção tem que ser https://hub.orbixsystem.com, senão o link chega quebrado.
SUPPORT_EMAIL=suporte@orbixsystem.com.br
ADMIN_API_TOKEN=troque_este_token_de_servico_com_pelo_menos_24_chars
