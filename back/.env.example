NODE_ENV=development
PORT=3000
# --- Postgres port note -------------------------------------------------------
# LOCAL (this machine, Podman): host port is 55432 (native PG owns 5432).
# CI / docker-compose:          host port is 5432.
# Keep your gitignored .env on 55432 locally; CI sets 5432 via service containers.
# -----------------------------------------------------------------------------
# App connects as the NON-privileged app_user (RLS enforced)
DATABASE_URL=postgresql://app_user:app_user_pw@localhost:55432/orbixhub?schema=public
# Migrations run as app_migrator (BYPASSRLS)
MIGRATION_DATABASE_URL=postgresql://app_migrator:app_migrator_pw@localhost:55432/orbixhub?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change_me_to_a_random_32_byte_minimum_secret_string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
ARGON_MEMORY_KIB=19456
ARGON_TIME_COST=2
ARGON_PARALLELISM=1
# --- Billing -----------------------------------------------------------------
# Plan key granted on trial signup (seeded plans: trial, pro)
TRIAL_PLAN_KEY=trial
TRIAL_DAYS=14
# false = validation phase: subscribe activates immediately, no gateway call.
# true  = checkout via PaymentGateway; status becomes authoritative via webhook.
BILLING_REQUIRE_PAYMENT=false
# HMAC-SHA256 secret the gateway signs webhook bodies with (min 16 chars).
BILLING_WEBHOOK_SECRET=dev_billing_webhook_secret_change_me
# --- Dev tools ---------------------------------------------------------------
# Dev tools — NEVER enable in production (exposes invite links / reset tokens via /dev/inbox)
DEV_TOOLS_ENABLED=false
# Public base URL of the app (used to build invite deep links in the dev inbox)
APP_PUBLIC_URL=http://localhost:8090
# --- Inventory catalog lookup (código-first) ---------------------------------
# External GTIN/EAN catalog provider:
#   noop          = always empty (validation phase)
#   cosmos        = cosmos.bluesoft.com.br (requires COSMOS_TOKEN)
#   openfoodfacts = world.openfoodfacts.org — free, public, NO token (best for grocery EANs)
CATALOG_PROVIDER=noop
# Master kill-switch. false = never call the external catalog (validation phase).
CATALOG_ENABLED=false
# Bearer token for cosmos.bluesoft.com.br — SECRET, never commit a real value.
COSMOS_TOKEN=
# User-Agent exigido pela Cosmos (mostrado na sua conta ao logar). Tem default.
COSMOS_USER_AGENT=OrbixHub/1.0 (+https://orbixhub)
# --- Object storage (fotos da OS, etc.) --------------------------------------
# Provider de storage:
#   local = disco em back/.storage, servido por GET /files/* (DEFAULT — sem container)
#   minio = S3-compatible (MinIO em dev / S3 em prod)
STORAGE_PROVIDER=local
# Base pública usada pelo provider LOCAL p/ montar a URL (a porta do backend; aqui 4400).
STORAGE_PUBLIC_URL=http://localhost:4400
# --- MinIO / S3 (só quando STORAGE_PROVIDER=minio) ---
# Subir o container (Podman):
#   podman run -d --name orbix-minio -p 9000:9000 -p 9001:9001 \
#     -e MINIO_ROOT_USER=orbix -e MINIO_ROOT_PASSWORD=orbix_minio_dev \
#     minio/minio server /data --console-address ":9001"
# Criar o bucket (console http://localhost:9001 ou mc):
#   mc alias set local http://127.0.0.1:9000 orbix orbix_minio_dev && mc mb local/orbix-os
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# SECRETS — nunca commitar valores reais (placeholders abaixo só p/ dev local).
S3_ACCESS_KEY=orbix
S3_SECRET_KEY=orbix_minio_dev
S3_BUCKET=orbix-os
# Base pública p/ servir os objetos (em dev = o próprio endpoint do MinIO).
S3_PUBLIC_URL=http://localhost:9000
