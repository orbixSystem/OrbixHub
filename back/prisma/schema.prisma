  tenant          tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id, cash_session_id], map: "idx_cash_entry_tenant_session")
  @@index([tenant_id, sale_kind, sale_id], map: "idx_cash_entry_tenant_sale")
  @@index([tenant_id, created_at], map: "idx_cash_entry_tenant_created")
  @@index([tenant_id, category], map: "idx_cash_entry_tenant_category")
