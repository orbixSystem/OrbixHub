generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_log {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String   @db.Uuid
  actor_user_id String?  @db.Uuid
  action        String
  target        String?
  metadata      Json?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  users         users?   @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)
  tenant        tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id, created_at], map: "idx_audit_tenant_time")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model customer {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String    @db.Uuid
  name       String
  type       String    @default("PF")
  document   String?
  phone      String?
  email      String?
  address    String?
  notes      String?
  status     String    @default("active")
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  tenant     tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subject    subject[]

  // Partial unique index `(tenant_id, document) WHERE document IS NOT NULL` is
  // created in SQL (Prisma can't express partial uniqueness). See sql baseline.
  @@index([tenant_id, created_at], map: "idx_customer_tenant_time")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model subject {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String   @db.Uuid
  customer_id       String   @db.Uuid
  label             String?
  identifier        String?
  attributes        Json?
  photo_url         String?
  photo_storage_key String?
  status            String   @default("active")
  /// Retorno completo da consulta por placa (exclusivo dela; nullable).
  plate_data        Json?
  plate_data_at     DateTime? @db.Timestamptz(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  customer    customer @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant      tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id, identifier], map: "idx_subject_tenant_identifier")
  @@index([tenant_id, customer_id], map: "idx_subject_tenant_customer")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model inventory_item {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String   @db.Uuid
  name              String
  sku               String?
  manufacturer_code String?
  barcode           String?
  category          String?
  brand             String?
  unit              String?
  sale_price        Decimal? @db.Decimal(14, 2)
  cost_price        Decimal? @db.Decimal(14, 2)
  margin_pct        Decimal? @db.Decimal(7, 2)
  current_stock     Decimal  @default(0) @db.Decimal(14, 3)
  min_stock         Decimal? @db.Decimal(14, 3)
  attributes        Json     @default(dbgenerated("'{}'::jsonb"))
  is_active         Boolean  @default(true)
  deleted_at        DateTime? @db.Timestamptz(6)
  kind              String   @default("product")
  duration_minutes  Int?
  ncm               String?
  cfop              String?
  origem            String?
  gtin              String?
  codigo_servico    String?
  aliquota_iss      Decimal? @db.Decimal(7, 2)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)
  tenant            tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id, barcode], map: "idx_inventory_item_tenant_barcode")
  @@index([tenant_id, manufacturer_code], map: "idx_inventory_item_tenant_mfrcode")
  @@index([tenant_id, sku], map: "idx_inventory_item_tenant_sku")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model stock_movement {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String   @db.Uuid
  inventory_item_id String   @db.Uuid
  stock_delta       Decimal  @db.Decimal(14, 3)
  reason            String
  ref_type          String
  ref_id            String   @db.Uuid
  ref_item_id       String?  @db.Uuid
  created_by        String?  @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  tenant            tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "idx_stock_movement_tenant")
  @@index([inventory_item_id], map: "idx_stock_movement_item")
  @@index([ref_item_id], map: "idx_stock_movement_ref_item")
  @@index([ref_type, ref_id], map: "idx_stock_movement_ref")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cash_session {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id               String       @db.Uuid
  opened_by               String       @db.Uuid
  opened_at               DateTime     @default(now()) @db.Timestamptz(6)
  opening_amount          Decimal      @default(0) @db.Decimal(14, 2)
