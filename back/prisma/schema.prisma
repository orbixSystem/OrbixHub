  error_message       String?
  entity_id           String?  @db.Uuid
  applied_at          DateTime @default(now()) @db.Timestamptz(6)
  tenant              tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, author_user_id, client_mutation_id], map: "uq_sync_mutation")
  @@index([tenant_id], map: "idx_sync_mutation_tenant")
}

