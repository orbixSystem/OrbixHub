<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Dev local: App Sandbox DESLIGADO no debug. Com ad-hoc signing (sem
	     certificado de desenvolvedor) a combinação sandbox + keychain-access-groups
	     falha (-34018 / "requires a development certificate"). Sem sandbox, o
	     flutter_secure_storage acessa o Keychain e a rede de saída funciona, tudo
	     com assinatura local. O Release mantém a sandbox ligada. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
