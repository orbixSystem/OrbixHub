<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Dev local: App Sandbox DESLIGADO no debug. Com ad-hoc signing (sem
	     certificado de desenvolvedor) a combinação sandbox + keychain-access-groups
	     falha (-34018 / "requires a development certificate"). Sem sandbox, o
	     flutter_secure_storage acessa o Keychain e a rede de saída funciona, tudo
	     com assinatura local. O Release mantém a sandbox ligada. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Seleção de arquivos (foto do veículo/OS, logo, certificado A1).
	     OBRIGATÓRIO MESMO COM A SANDBOX DESLIGADA: o file_picker consulta os
	     entitlements do processo (SecTaskCopyValueForEntitlement) e recusa a
	     operação com ENTITLEMENT_NOT_FOUND antes de abrir o diálogo. Read-write
	     (não read-only) porque o painel de impressão salva PDF em disco. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Impressão de OS/ficha/relatórios (package printing). -->
	<key>com.apple.security.print</key>
	<true/>
</dict>
</plist>
